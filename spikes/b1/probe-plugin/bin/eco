#!/usr/bin/env python3
"""Sonda B1-V5: legge tutto stdin e lo scrive, byte per byte, nel file `$B1_ECO_OUT` (altrimenti
`/tmp/tollgate-b1/eco.txt`; mai sotto la HOME). `raccogli` lo confronta con il testo atteso."""
import os
import sys

DEFAULT_OUT = "/tmp/tollgate-b1/eco.txt"


def main():
    data = sys.stdin.buffer.read()
    path = os.environ.get("B1_ECO_OUT") or DEFAULT_OUT
    home = os.path.realpath(os.environ.get("HOME") or "/nonexistent-home")
    real = os.path.realpath(path)
    if not os.path.isabs(path) or real == home or real.startswith(home + os.sep):
        sys.stderr.write("eco: percorso non ammesso (relativo o sotto la HOME)\n")
        return 1
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "wb") as fh:
        fh.write(data)
    print("eco: %d byte" % len(data))
    return 0


if __name__ == "__main__":
    sys.exit(main())
