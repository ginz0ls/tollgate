#!/usr/bin/env bash
# Shim di `gh` per gli eval (decisione 3): esegue il finto gh (tests/fakegh.py) sui dati della HOME della corsa.
# Senza dati esce con 1 e non cerca mai un altro `gh` nel PATH: nella corsa non si parla con GitHub.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../.." && pwd)"
data="${HOME:-}/.tollgate-eval/fakegh-data.json"
if [ -z "${HOME:-}" ] || [ ! -f "$data" ]; then
  echo "gh finto dell'eval: dati assenti" >&2
  exit 1
fi
export TOLLGATE_FAKEGH_DATA="$data"
export TOLLGATE_FAKEGH_LOG="$HOME/.tollgate-eval/fakegh.log"
exec "$here/python3" "$root/tests/fakegh.py" "$@"
